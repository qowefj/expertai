events {
    worker_connections 1024;
}

http {
    # Increase timeouts to prevent 504 errors
    proxy_connect_timeout 200s;
    proxy_send_timeout 200s;
    proxy_read_timeout 200s;
    
    # Buffer settings
    proxy_buffering on;
    proxy_buffer_size 4k;
    proxy_buffers 8 4k;
    proxy_busy_buffers_size 8k;
    
    upstream app {
        server app:3000;
    }
    
    server {
        listen 80;
        server_name _;
        
        # Increase client body size if needed
        client_max_body_size 10M;
        
        location / {
            proxy_pass http://app;
            proxy_http_version 1.1;
            
            # Headers
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            # Timeouts (must be >= app timeout)
            proxy_connect_timeout 200s;
            proxy_send_timeout 200s;
            proxy_read_timeout 200s;
        }
        
        # Health check endpoint (no timeout)
        location /api/submissions/count {
            proxy_pass http://app;
            proxy_read_timeout 10s;
        }
        
        # Static files (can use shorter timeout)
        location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            proxy_pass http://app;
            proxy_read_timeout 30s;
            expires 1d;
            add_header Cache-Control "public, immutable";
        }
    }
}
